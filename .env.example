# Shared household passcode. Required in production, at least 12 characters: a few random words works well,
# e.g. "tomato basil sunday roast". Leave unset locally to skip the login screen.
HOUSEHOLD_PASSCODE=
# Random string used to sign the login cookie. Required in production, at least 32 characters (openssl rand -hex 32).
# Changing it, or the passcode, signs every device out.
AUTH_SECRET=

# Public address of the site, used in MyFitnessPal share links (e.g. https://meals.example.com).
SITE_URL=

# PostgreSQL database; the app creates its own tables. Leave unset to use .data/db.json. Photos stay in .data/photos/.
DATABASE_URL=

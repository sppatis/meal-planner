# Shared household passcode for the app. Leave unset locally to skip the login screen.
HOUSEHOLD_PASSCODE=
# Long random string used to sign the login cookie (e.g. `openssl rand -hex 32`).
AUTH_SECRET=

# Supabase project (Dashboard > Project Settings > API). Leave unset locally to use .data/db.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
